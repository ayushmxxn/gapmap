# GapMap Environment Variables
# Copy this file to .env.local for local overrides (never commit .env.local).
# By default, GapMap runs in mock mode with zero API keys and zero external network calls.

# ==============================================================================
# 1. CLIENT CONFIGURATION (Intentionally Public — Bundled to Browser)
# ==============================================================================

# Mock mode switch ("true" | "false").
# Default: true.
# Publicly accessible because browser search hooks & map interactions check this
# to bypass external Mapbox geocoding calls and use local offline presets instead.
NEXT_PUBLIC_USE_MOCK=true

# Mapbox GL Public Access Token (pk.*).
# Required for live interactive Mapbox maps and geocoding in the browser.
# Publicly accessible because Mapbox GL JS runs directly in the client canvas.
# Optional in mock mode (falls back to graceful SVG/canvas preview).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Canonical Application Base URL (e.g. https://gapmap.app or http://localhost:3000).
# Used for OpenGraph preview tags, XML sitemaps, and canonical metadata.
# Optional in development and on Vercel (automatically falls back to VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_APP_URL=

# ==============================================================================
# 2. SERVER SECRETS (Server-Only — NEVER expose to browser or prefix with NEXT_PUBLIC_)
# ==============================================================================

# SerpApi API Key (Private Secret).
# Used strictly within server route handlers (/api/scan) for Google Maps,
# Google Reviews sentiment, and Google Trends timeline ingestion.
# Required only when running live market scans (NEXT_PUBLIC_USE_MOCK=false).
# This key is NEVER included in client bundles or client error messages.
SERPAPI_KEY=
